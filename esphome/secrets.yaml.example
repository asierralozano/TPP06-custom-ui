# Copia este fichero a  esphome/secrets.yaml  (que está gitignored) y rellena.
# NUNCA subas secrets.yaml al repo.

# Clave de cifrado de la API de ESPHome <-> Home Assistant (base64, 32 bytes).
# Genera una con:   openssl rand -base64 32
tpp06_api_encryption_key: "PON_AQUI_TU_CLAVE_BASE64_DE_32_BYTES"

# (Opcional, para más adelante: WiFi del onboarding, etc.)
# wifi_ssid: "..."
# wifi_password: "..."
